# Environment Variables

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Database (Production)
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"

# ============================================
# AUTHENTICATION
# ============================================

JWT_SECRET="your-secret-key-here-change-in-production"

# ============================================
# BACKUP AND DISASTER RECOVERY
# ============================================

# Backup Encryption (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BACKUP_ENCRYPTION_KEY="your-64-character-hex-key-here"

# Backup Retention Policy
BACKUP_RETENTION_DAYS="30"
BACKUP_RETENTION_MONTHS="12"

# Cloud Storage Provider (Options: S3, B2, AZURE, LOCAL)
BACKUP_CLOUD_PROVIDER="LOCAL"
BACKUP_CLOUD_BUCKET="your-backup-bucket"
BACKUP_CLOUD_REGION="eu-west-1"
BACKUP_CLOUD_ACCESS_KEY="your-access-key"
BACKUP_CLOUD_SECRET_KEY="your-secret-key"

# ============================================
# SUPABASE CONFIGURATION
# ============================================

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ============================================
# API CONFIGURATION
# ============================================

NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ============================================
# AI SERVICES (Optional)
# ============================================

COHERE_API_KEY="your-cohere-api-key"
PINECONE_API_KEY="your-pinecone-api-key"
ZAI_API_KEY="your-zai-api-key"

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-password"

# Note: Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will not be committed
